# 环境变量（包含API密钥，绝对不能上传）
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# PyInstaller 打包产物
AI简历助手包/
AI简历助手封装包/
最终版/

# 虚拟环境
venv/
.venv/

# IDE
.vscode/
.idea/

# 系统文件
Thumbs.db
.DS_Store

# 日志（运行时生成）
logs/*.txt
logs/*.log
!logs/.gitkeep

# 运行时数据
data/*.json
!data/.gitkeep

# 简历原始文件（隐私）
resumes/*.docx
resumes/*.pdf
!resumes/test.txt

# 证件照（隐私）
photos/*.jpg
photos/*.jpeg
photos/*.png
.vercel
.env*

# 本地 SQLite 数据库与备份（隐私及运行期产物）
data/*.db
data/*.db-journal
backups/
*.bak
_tmp_*


# 桌面端打包产物与安装包（通过 GitHub Releases 分发，不进 Git 仓库）
dist/
build/
*.exe
external/

# 运行期工作区、导出文件与临时测试文件
data/workspaces/
resumes/exports/
logs/
.codex_tmp/
promo-video/
reports/
frontend/node_modules/
d13_temp.txt
d14_*.json
d18_*.json
table12_clean.json
